# ==============================================================================
# UMUGUZIPRO ENVIRONMENT CONFIGURATION
# ==============================================================================

# Database (PostgreSQL - Neon, Supabase, Vercel Postgres, or self-hosted)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/umuguzi?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/umuguzi?schema=public"

# Application URL
APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Authentication & Session Security (Generate with: openssl rand -base64 32)
AUTH_SECRET="super-secret-jwt-and-session-encryption-key-change-in-production-32-chars"

# Email Delivery (Resend or SMTP via Nodemailer)
RESEND_API_KEY="re_sample_key_here"
EMAIL_FROM="Umuguzi Pro <onboarding@resend.dev>"

# Optional SMTP fallback credentials
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""

# Cloud Storage Integration (AWS S3, Cloudflare R2, Supabase Storage, Vercel Blob)
STORAGE_ENDPOINT=""
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET=""
STORAGE_REGION="auto"
NEXT_PUBLIC_STORAGE_URL=""

# Payment Gateways (Flutterwave, Paypack Rwanda, MTN MoMo, Stripe)
PAYMENT_PROVIDER_KEY=""
PAYMENT_SECRET_KEY=""
